# Copiar a .env dentro de Backend. No añadir comillas a los valores.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lenas_sabores
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CAMBIA_ESTA_CLAVE
PORT=8080
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false

# Habilitar solo cuando se configure un servidor SMTP real.
PASSWORD_RESET_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@localhost

# Google Cloud: cliente OAuth de tipo Aplicación web.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/login/oauth2/code/google
